[Unit]
Description=MapleBBS WebSocket Bridge
After=network.target maplebbs-bbsd.service
PartOf=maplebbs.target

[Service]
Type=exec
User=bbs
Group=bbs
WorkingDirectory=/home/bbs/src/websocket
# Dynamically use the default Node.js version via nvm-exec
Environment=NODE_VERSION=default
ExecStart=/home/bbs/.nvm/nvm-exec node wsd.js
Restart=always
RestartSec=5
Environment=BBS_HOST=127.0.0.1
Environment=BBS_PORT=23
Environment=WS_PORT=8888

[Install]
WantedBy=maplebbs.target
