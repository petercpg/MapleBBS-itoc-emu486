[Unit]
Description=MapleBBS Telnet Server
After=network.target syslog.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/home/bbs

# Core Daemons (Root)
# Start sequence based on rc.local
# Clean up orphaned IPC resources before starting
ExecStartPre=/bin/sh -c 'for id in $$(/usr/bin/ipcs -m | grep bbs | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -m $$id 2>/dev/null; done; true'
ExecStartPre=/bin/sh -c 'for id in $$(/usr/bin/ipcs -s | grep bbs | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -s $$id 2>/dev/null; done; true'
ExecStartPre=/bin/sh -c 'for id in $$(/usr/bin/ipcs -q | grep bbs | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -q $$id 2>/dev/null; done; true'
ExecStart=/home/bbs/bin/bbsd
ExecStart=/home/bbs/bin/bmtad
ExecStart=/home/bbs/bin/gemd
ExecStart=/home/bbs/bin/bguard
ExecStart=/home/bbs/bin/bpop3d
ExecStart=/home/bbs/bin/bnntpd
ExecStart=/home/bbs/bin/xchatd
ExecStart=/home/bbs/innd/innbbsd

# Maintenance Utilities (Run as user 'bbs')
ExecStart=/usr/sbin/runuser -u bbs -- /home/bbs/bin/camera
ExecStart=/usr/sbin/runuser -u bbs -- /home/bbs/bin/account

# Cleanup
# Systemd implicitly kills processes in the cgroup on stop.
# We explicitly clean up shared memory segments, semaphores, and message queues owned by 'bbs'.
ExecStopPost=/bin/sh -c 'for id in $$(/usr/bin/ipcs -m | grep bbs | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -m $$id 2>/dev/null; done; true'
ExecStopPost=/bin/sh -c 'for id in $$(/usr/bin/ipcs -s | grep bbs | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -s $$id 2>/dev/null; done; true'
ExecStopPost=/bin/sh -c 'for id in $$(/usr/bin/ipcs -q | grep bbs | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -q $$id 2>/dev/null; done; true'

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
