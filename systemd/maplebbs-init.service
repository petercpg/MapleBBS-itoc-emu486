[Unit]
Description=MapleBBS IPC Initialization and Cleanup
After=network.target syslog.target
PartOf=maplebbs.target

[Service]
Type=oneshot
User=bbs
Group=bbs
WorkingDirectory=%h
# Use '+' to run directory setup as root once, ensuring path belongs to user/group defined above
ExecStartPre=+/usr/bin/mkdir -p %h/run
ExecStartPre=+/usr/bin/chown -R %u:%g %h/run
# Clean up orphaned IPC resources (as %u)
ExecStart=/bin/sh -c 'for id in $$(/usr/bin/ipcs -m | grep %u | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -m $$id 2>/dev/null; done; true'
ExecStart=/bin/sh -c 'for id in $$(/usr/bin/ipcs -s | grep %u | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -s $$id 2>/dev/null; done; true'
ExecStart=/bin/sh -c 'for id in $$(/usr/bin/ipcs -q | grep %u | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -q $$id 2>/dev/null; done; true'

# Also clean up when the service stops (or restarts)
ExecStopPost=/bin/sh -c 'for id in $$(/usr/bin/ipcs -m | grep %u | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -m $$id 2>/dev/null; done; true'
ExecStopPost=/bin/sh -c 'for id in $$(/usr/bin/ipcs -s | grep %u | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -s $$id 2>/dev/null; done; true'
ExecStopPost=/bin/sh -c 'for id in $$(/usr/bin/ipcs -q | grep %u | awk '\''{print $$2}'\''); do /usr/bin/ipcrm -q $$id 2>/dev/null; done; true'

RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
